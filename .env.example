
# Password required to access /admin and call/serve/skip/reset tokens.
ADMIN_PASSWORD=change-me

# Random string used to sign the admin session cookie. Any long random
# value works, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# Set to 1 to run Flask's debug server locally (auto-reload, interactive
# debugger). Leave unset or 0 in production.
FLASK_DEBUG=0

# for you automatically — you usually don't need to set it yourself.
PORT=5000
